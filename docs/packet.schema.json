{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/proofpacket/packet.schema.json",
  "title": "Proofpacket evidence packet",
  "type": "object",
  "required": ["schema_version", "task", "selected_paths", "claims", "assumptions", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "task": {"type": "string", "minLength": 1},
    "selected_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selectedPath"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/note"}},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "note": {"type": "object", "required": ["id", "text"], "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}}},
    "selectedPath": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "claim": {"allOf": [{"$ref": "#/$defs/note"}, {"type": "object", "required": ["check_ids"], "properties": {"check_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}}]},
    "check": {
      "type": "object",
      "required": ["id", "argv", "cwd", "started_at", "finished_at", "status", "exit_code", "stdout", "stderr", "stdout_truncated", "stderr_truncated", "stdout_sha256", "stderr_sha256", "before", "after", "changed_during_run"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "cwd": {"const": "."},
        "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["completed", "timeout"]}, "exit_code": {"type": ["integer", "null"]},
        "stdout": {"type": "string"}, "stderr": {"type": "string"}, "stdout_truncated": {"type": "boolean"}, "stderr_truncated": {"type": "boolean"},
        "stdout_sha256": {"$ref": "#/$defs/digest"}, "stderr_sha256": {"$ref": "#/$defs/digest"},
        "before": {"type": "object", "additionalProperties": {"$ref": "#/$defs/digest"}},
        "after": {"type": "object", "additionalProperties": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}},
        "changed_during_run": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
